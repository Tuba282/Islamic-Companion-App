{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "pnpm --filter @workspace/islamic-companion start",
    "dev": "pnpm --filter @workspace/islamic-companion dev",
    "web": "pnpm --filter @workspace/islamic-companion web",
    "android": "pnpm --filter @workspace/islamic-companion android",
    "ios": "pnpm --filter @workspace/islamic-companion ios",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
